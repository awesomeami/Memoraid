# GEMINI_API_KEY: Only applies to the AI Studio sandbox environment.
# This variable is NOT used in the deployed app (e.g., Vercel, production), 
# as users securely provide their own personal Gemini API Key directly in the Settings tab.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE_SERVICE_ACCOUNT_KEY: JSON string of the Firebase service account private key.
# Required for non-GCP hosting platforms like Vercel.
# Generate this value in the Firebase Console under Project Settings -> Service Accounts -> Generate new private key.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "...", ...}'

# Optional single model pins for a tested rollout or an emergency rollback.
# Defaults: gemini-3.8-flash, gemini-flash-lite-latest, gemini-3.1-pro-preview.
# OCR always uses gemini-flash-lite-latest and ignores these generation model pins.
# No model discovery or fallback requests; keys still rotate on quota errors.
# Changing Vercel environment variables takes effect on the next deployment.
# GEMINI_FLASH_MODEL=gemini-3.8-flash
# GEMINI_FLASH_LITE_MODEL=gemini-3.5-flash-lite
# GEMINI_PRO_MODEL=gemini-3.1-pro-preview
